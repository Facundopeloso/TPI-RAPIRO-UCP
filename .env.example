# ── LLM ──────────────────────────────────────────────────────────────────────
# Obtener en: https://console.anthropic.com/settings/keys
# OBLIGATORIA para correr el demo del tutor (demo.py --quiz, test_tutor.py, etc.)
ANTHROPIC_API_KEY=sk-ant-api03-TU_KEY_REAL_ACA

# ── Modelo de clasificación ───────────────────────────────────────────────────
MODEL_PATH=models/mobilenetv2_int8.tflite
MIN_CONFIDENCE=0.35
# Umbral aparte para la clase "ausente" (más bajo = detecta antes, más falsos positivos)
MIN_CONFIDENCE_ABSENT=0.20

# ── Hardware (sólo Raspberry Pi con hardware real) ────────────────────────────
SERIAL_PORT=/dev/ttyAMA0
SERIAL_BAUD_RATE=57600
CAMERA_INDEX=0
CAMERA_FPS=2
# Sólo si se usa una cámara IP (ej. DroidCam) en vez de la webcam USB/CSI local
CAMERA_URL=http://192.168.x.x:4747/video
LED_RED_PIN=17
LED_GREEN_PIN=27
LED_BLUE_PIN=22
DO_NOT_DISTURB_PIN=23
DO_NOT_DISTURB_DURATION_SEC=600

# ── AWS (sólo si se usa la integración cloud completa) ────────────────────────
AWS_REGION=sa-east-1
AWS_IOT_ENDPOINT=tu-endpoint-ats.iot.sa-east-1.amazonaws.com
AWS_IOT_TOPIC=rapiro/events
AWS_IOT_CERT_PATH=certs/certificate.pem.crt
AWS_IOT_KEY_PATH=certs/private.pem.key
AWS_IOT_CA_PATH=certs/AmazonRootCA1.pem
AWS_DYNAMODB_TABLE=rapiro_sessions_dev
AWS_S3_BUCKET=rapiro-user-documents
S3_BUCKET=rapiro-user-documents-dev-TU_CUENTA_AWS
MQTT_THROTTLE_SECONDS=5
ABSENCE_ALERT_THRESHOLD_SEC=300

# ── Tutoría / voz ───────────────────────────────────────────────────────────────
POLLY_VOICE=Enrique
POLLY_ENGINE=standard
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=500
DOCUMENT_CHUNK_SIZE_WORDS=500
DOCUMENT_TOP_K_CHUNKS=3
TUTOR_HOTWORD=RAPIRO ayuda
SPEECH_LANGUAGE=es-AR

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
