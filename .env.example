# Hardware
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=9600
CAMERA_INDEX=0
CAMERA_FPS=2
LED_RED_PIN=17
LED_GREEN_PIN=27
LED_BLUE_PIN=22
DO_NOT_DISTURB_PIN=23
DO_NOT_DISTURB_DURATION_SEC=600

# Modelo
MODEL_PATH=models/mobilenetv2_int8.tflite
MIN_CONFIDENCE=0.70

# AWS
AWS_REGION=sa-east-1
AWS_IOT_ENDPOINT=avo0u2lyknj7h-ats.iot.sa-east-1.amazonaws.com
AWS_IOT_TOPIC=rapiro/events
AWS_IOT_CERT_PATH=certs/certificate.pem.crt
AWS_IOT_KEY_PATH=certs/private.pem.key
AWS_IOT_CA_PATH=certs/AmazonRootCA1.pem
AWS_DYNAMODB_TABLE=rapiro_sessions_dev
AWS_S3_BUCKET=rapiro-user-documents-dev-442650748881
MQTT_THROTTLE_SECONDS=5
ABSENCE_ALERT_THRESHOLD_SEC=300


# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZAR_CON_TU_KEY
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=500

# Tutoría
DOCUMENT_CHUNK_SIZE_WORDS=500
DOCUMENT_TOP_K_CHUNKS=3
TUTOR_HOTWORD=RAPIRO ayuda
SPEECH_LANGUAGE=es-AR

# Dashboard
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO