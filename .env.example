# Hardware
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=9600
CAMERA_INDEX=0
CAMERA_FPS=2
LED_RED_PIN=17
LED_GREEN_PIN=27
LED_BLUE_PIN=22
DO_NOT_DISTURB_PIN=23
DO_NOT_DISTURB_DURATION_SEC=600

# Modelo
MODEL_PATH=models/mobilenetv2_int8.tflite
MIN_CONFIDENCE=0.70

# AWS
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=xxxxx.iot.us-east-1.amazonaws.com
AWS_IOT_TOPIC=rapiro/events
AWS_IOT_CERT_PATH=certs/certificate.pem.crt
AWS_IOT_KEY_PATH=certs/private.pem.key
AWS_IOT_CA_PATH=certs/AmazonRootCA1.pem
AWS_DYNAMODB_TABLE=rapiro_sessions
AWS_S3_BUCKET=rapiro-user-documents
MQTT_THROTTLE_SECONDS=5
ABSENCE_ALERT_THRESHOLD_SEC=300

# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3

# Tutoría
DOCUMENT_CHUNK_SIZE_WORDS=500
DOCUMENT_TOP_K_CHUNKS=3
TUTOR_HOTWORD=RAPIRO ayuda
SPEECH_LANGUAGE=es-AR

# Dashboard
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
